<nav
  id="topnavbar"
  class="relative overflow-hidden group w-11/12 max-w-2xl py-3 px-6 mt-6 mx-auto bg-white/13 backdrop-blur-[12px] backdrop-saturate-[100%] border border-white/30 rounded-[16px] shadow-[0_8px_32px_0_rgba(0,0,0,0.2)] cursor-default"
>
  <!-- Spotlight Glow Layer -->
  <div
    class="spotlight-glow pointer-events-none absolute inset-0 transition-opacity duration-300 opacity-0 group-hover:opacity-100 z-0"
    style="background: radial-gradient(180px circle at var(--x, 50%) var(--y, 50%), rgba(255, 255, 255, 0.4), transparent 70%);"
  >
  </div>

  <!-- Navbar Content -->
  <ul
    class="relative z-10 flex items-center justify-around text-sm font-medium text-slate-200"
  >
    <li>
      <a
        href="#home"
        class="px-4 py-1.5 rounded-full hover:text-cyan-400 hover:bg-white/10 transition-all duration-200"
        >Home</a
      >
    </li>
    <li>
      <a
        href="#services"
        class="px-4 py-1.5 rounded-full hover:text-cyan-400 hover:bg-white/10 transition-all duration-200"
        >Services</a
      >
    </li>
    <li>
      <a
        href="#projects"
        class="px-4 py-1.5 rounded-full hover:text-cyan-400 hover:bg-white/10 transition-all duration-200"
        >Projects</a
      >
    </li>
    <li>
      <a
        href="#about"
        class="px-4 py-1.5 rounded-full hover:text-cyan-400 hover:bg-white/10 transition-all duration-200"
        >About</a
      >
    </li>
    <li>
      <a
        href="#contact"
        class="px-4 py-1.5 rounded-full hover:text-cyan-400 hover:bg-white/10 transition-all duration-200"
        >Contact</a
      >
    </li>
  </ul>
</nav>

<script>
  function setupNavbarSpotlight() {
    const nav = document.getElementById('topnavbar');
    if (!nav) return;

    nav.addEventListener('pointermove', (e) => {
      const rect = nav.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      nav.style.setProperty('--x', `${x}px`);
      nav.style.setProperty('--y', `${y}px`);
    });
  }

  setupNavbarSpotlight();
  document.addEventListener('astro:page-load', setupNavbarSpotlight);
</script>
